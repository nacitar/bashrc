#!/bin/bash
set -eu

# Manages locally built packages: ones that exist in no repository, so a normal
# system update never touches them.
#
#   ns-custom-packages [update [--no-pull] [NAME...]]
#   ns-custom-packages list
#   ns-custom-packages available
#   ns-custom-packages add [--yes] SOURCE [NAME]
#   ns-custom-packages install [--yes] SOURCE|NAME
#   ns-custom-packages remove [--keep-source] NAME
#
# SOURCE is a directory, a name from the catalog (see `available`), or a git URL.
# A catalog name or URL is cloned into ${XDG_DATA_HOME:-~/.local/share}/ns-custom-packages;
# a directory is used where it is. `install` of an unmanaged SOURCE adds it first.
#
# The managed packages are listed in
#   ${XDG_CONFIG_HOME:-~/.config}/ns-custom-packages/packages
# one per line as `<directory> [package-name]`; `add` and `remove` edit it, and
# it can be edited by hand too ('#' comments and blank lines are kept).
#
# The catalog maps names to git URLs. It is built into this script and can be
# extended or overridden by
#   ${XDG_CONFIG_HOME:-~/.config}/ns-custom-packages/catalog
# with one `<name> <git-url>` per line.
#
# Each directory holds a PKGBUILD and an update.sh that follows a small
# contract: `update.sh --check` exits 10 when a rebuild is needed, and a bare
# `update.sh` builds the package into that directory (never using sudo).
# `update` first fast-forwards each package's git checkout (when it is a clean
# checkout with an upstream), runs those, and installs what they built, so it
# belongs after the system update, once the package databases are current.
# Everything a package's repository contains runs as you, and the package it
# builds is installed as root, so only manage repositories you trust.
#
# `update` only manages a package once it is installed. The first install is
# `install`, which shows pacman's own questions (for instance, whether to
# replace the official package this one stands in for).

# Avoid leaking an active venv into builds.
unset VIRTUAL_ENV

config_dir=${XDG_CONFIG_HOME:-${HOME}/.config}/ns-custom-packages
data_dir=${XDG_DATA_HOME:-${HOME}/.local/share}/ns-custom-packages
packages_file=${NS_CUSTOM_PACKAGES_FILE:-${config_dir}/packages}
catalog_file=${config_dir}/catalog

# name -> git URL of packages that can be installed by name
declare -A catalog=(
    [kitty-pseudo-transparency]=https://github.com/sevaht/kitty-pseudo-transparency.git
)

usage() {
    cat <<'EOF'
Usage:
  ns-custom-packages [update [--no-pull] [NAME...]]   build and install what is out of date
  ns-custom-packages list                             managed packages and their status
  ns-custom-packages available                        packages that can be installed by name
  ns-custom-packages add [--yes] SOURCE [NAME]        manage a directory, catalog package or git URL
  ns-custom-packages install [--yes] SOURCE|NAME      add if needed, build, and install
  ns-custom-packages remove [--keep-source] NAME      uninstall and stop managing

SOURCE is a directory, a catalog name (see `available`), or a git URL.
EOF
}

die() {
    >&2 echo "ERROR: $*"
    exit 1
}

if ! command -v pacman >/dev/null 2>&1; then
    die "${0} only supports ArchLinux."
fi

# ---------------------------------------------------------------- the list

entry_dirs=()
entry_names=()

# Fills entry_dirs / entry_names from the packages file.
load_entries() {
    entry_dirs=()
    entry_names=()
    [[ -f ${packages_file} ]] || return 0
    local dir name _
    # Read on fd 3 so that commands run later can't consume the list.
    while read -r dir name _ <&3; do
        [[ -z ${dir} || ${dir} == '#'* ]] && continue
        dir=${dir/#\~\//${HOME}/}
        entry_dirs+=("${dir}")
        entry_names+=("${name:-$(basename "${dir}")}")
    done 3< "${packages_file}"
}

# Sets entry_index to the position of NAME; fails if it isn't managed.
find_entry() {
    local i
    for i in "${!entry_names[@]}"; do
        if [[ ${entry_names[i]} == "$1" ]]; then
            entry_index=${i}
            return 0
        fi
    done
    return 1
}

# Replaces a leading $HOME with ~ for storing and showing paths.
tilde() {
    echo "${1/#"${HOME}"\//\~/}"
}

# -------------------------------------------------------- catalog and clones

# Adds the user's catalog file to the built-in catalog.
load_catalog() {
    [[ -f ${catalog_file} ]] || return 0
    local name url _
    while read -r name url _ <&3; do
        [[ -z ${name} || ${name} == '#'* || -z ${url} ]] && continue
        catalog[${name}]=${url}
    done 3< "${catalog_file}"
}

is_url() {
    [[ $1 == *://* || $1 == git@*:* || $1 == *.git ]]
}

assume_yes=0
resolved_dir=
resolved_name=
resolved_cloned=0

# Finds the directory for SOURCE, cloning it first when it is a catalog name or
# a git URL. Sets resolved_dir, resolved_name (the catalog name, if it was one)
# and resolved_cloned; fails if SOURCE is none of those. Not for use in $(...),
# since it sets variables.
resolve_source() {
    local source=$1 url name
    resolved_dir='' resolved_name='' resolved_cloned=0
    load_catalog
    if [[ ${source} != */* && -n ${catalog[${source}]+set} ]]; then
        name=${source}
        url=${catalog[${source}]}
        resolved_name=${name}
    elif [[ -d ${source} ]]; then
        resolved_dir=$(realpath -- "${source}")
        return 0
    elif is_url "${source}"; then
        url=${source}
        name=${url##*[/:]}
        name=${name%.git}
        if (( ! assume_yes )); then
            >&2 echo "${url} is not in the catalog. Its PKGBUILD and update.sh run as you, and the"
            >&2 echo "package it builds is installed as root."
            local answer=
            read -r -p "Continue? [y/N] " answer || true
            [[ ${answer} == [yY]* ]] || die "aborted."
        fi
    else
        return 1
    fi
    local target=${data_dir}/${name}
    if [[ -e ${target} ]]; then
        # a checkout left behind by `remove` is reused when it is of the same repository
        [[ $(git -C "${target}" remote get-url origin 2>/dev/null) == "${url}" ]] || die "${target} already exists."
        >&2 echo "Using the existing checkout $(tilde "${target}")."
        resolved_dir=${target}
        return 0
    fi
    mkdir -p "${data_dir}"
    >&2 echo "Cloning ${url}..."
    GIT_TERMINAL_PROMPT=0 git clone --quiet -- "${url}" "${target}" || die "could not clone ${url}."
    resolved_dir=${target}
    resolved_cloned=1
}

# Fast-forwards DIR's git checkout when it is a clean one with an upstream. Never
# fails: anything else is skipped, with a note where it is worth one.
# Usage: pull_checkout DIR NAME
pull_checkout() {
    local dir=$1 name=$2 before after output
    git -C "${dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    git -C "${dir}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1 || return 0
    if [[ -n $(git -C "${dir}" status --porcelain --untracked-files=no) ]]; then
        echo "${name}: has local changes; not pulling."
        return 0
    fi
    before=$(git -C "${dir}" rev-parse HEAD)
    if ! output=$(GIT_TERMINAL_PROMPT=0 git -C "${dir}" pull --ff-only --quiet 2>&1); then
        >&2 echo "WARNING: ${name}: could not fast-forward (${output##*$'\n'}); using the checkout as it is."
        return 0
    fi
    after=$(git -C "${dir}" rev-parse HEAD)
    if [[ ${before} != "${after}" ]]; then
        echo "${name}: pulled new commits."
    fi
}

# Deletes DIR if this tool cloned it (it is under the data directory) and it holds
# nothing worth keeping: no changes to tracked files and no unpushed commits.
# Usage: delete_checkout DIR NAME
delete_checkout() {
    local dir=$1 name=$2
    [[ ${dir} == "${data_dir}"/* && -d ${dir} ]] || return 0
    if git -C "${dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if [[ -n $(git -C "${dir}" status --porcelain --untracked-files=no) ]]; then
            echo "Kept $(tilde "${dir}"): it has uncommitted changes."
            return 0
        fi
        if [[ -n $(git -C "${dir}" log --branches --not --remotes --oneline 2>/dev/null) ]]; then
            echo "Kept $(tilde "${dir}"): it has commits that were never pushed."
            return 0
        fi
    fi
    rm -rf -- "${dir}"
    echo "Deleted the checkout $(tilde "${dir}")."
}

# ------------------------------------------------------------ package state

# Prints the installed version of package NAME; fails if it isn't installed.
installed_version() {
    local line
    line=$(pacman -Q "$1" 2>/dev/null) || return 1
    echo "${line##* }"
}

# Prints the newest package file built in DIR for package NAME; fails if none.
# ("${name}-[0-9]*" leaves out the "-debug" package.)
newest_package() {
    local newest
    newest=$(ls -t "$1/$2"-[0-9]*.pkg.tar.* 2>/dev/null | head -n1 || true)
    [[ -n ${newest} ]] || return 1
    echo "${newest}"
}

package_file_version() {
    pacman -Qip "$1" | awk '/^Version/ {print $3}'
}

# Runs DIR's update.sh --check and rebuilds if it asks for that.
# Usage: build_if_needed DIR NAME
build_if_needed() {
    local status=0
    "$1/update.sh" --check || status=$?
    if (( status == 10 )); then
        echo "$2: rebuilding..."
        "$1/update.sh" || return 1
    elif (( status != 0 )); then
        >&2 echo "ERROR: $2: update check failed (exit ${status})."
        return 1
    fi
}

# ----------------------------------------------------------------- commands

do_pull=1

update_one() {
    local dir=$1 name=$2 installed package built
    if [[ ! -x ${dir}/update.sh ]]; then
        >&2 echo "WARNING: ${name}: ${dir}/update.sh not found; skipping."
        return 0
    fi
    if ! installed=$(installed_version "${name}"); then
        echo "${name}: not installed; skipping (use: ns-custom-packages install ${name})."
        return 0
    fi
    if (( do_pull )); then
        pull_checkout "${dir}" "${name}"
    fi
    if ! build_if_needed "${dir}" "${name}"; then
        >&2 echo "ERROR: ${name}: update failed; leaving ${installed} installed."
        return 1
    fi
    # The newest build may also have been made earlier, by hand.
    if ! package=$(newest_package "${dir}" "${name}"); then
        echo "${name}: up to date (${installed})."
        return 0
    fi
    built=$(package_file_version "${package}")
    if [[ ${built} == "${installed}" ]]; then
        echo "${name}: up to date (${installed})."
        return 0
    fi
    echo "${name}: installing ${built} (was ${installed})..."
    if ! sudo pacman -U --noconfirm "${package}"; then
        >&2 echo "ERROR: ${name}: install failed."
        return 1
    fi
}

cmd_update() {
    local wanted=() failures=0 i name arg
    for arg in "$@"; do
        case ${arg} in
            --no-pull) do_pull=0 ;;
            -*) die "unknown option: ${arg}" ;;
            *) wanted+=("${arg}") ;;
        esac
    done
    load_entries
    echo "custom packages: checking..."
    if (( ! ${#entry_names[@]} )); then
        echo "custom packages: none managed (see: ns-custom-packages add); nothing to do."
        return 0
    fi
    for name in ${wanted[@]+"${wanted[@]}"}; do
        find_entry "${name}" || die "${name} isn't a managed package."
    done
    for i in "${!entry_names[@]}"; do
        name=${entry_names[i]}
        if (( ${#wanted[@]} )) && [[ " ${wanted[*]} " != *" ${name} "* ]]; then
            continue
        fi
        update_one "${entry_dirs[i]}" "${name}" || failures=$((failures + 1))
    done
    if (( failures )); then
        die "${failures} custom package(s) failed to update."
    fi
}

cmd_list() {
    load_entries
    if (( ! ${#entry_names[@]} )); then
        echo "No custom packages are managed (see: ns-custom-packages available, or add DIRECTORY)."
        return 0
    fi
    printf '%-28s %-14s %-24s %s\n' NAME INSTALLED STATUS DIRECTORY
    local i name dir installed status package built
    for i in "${!entry_names[@]}"; do
        name=${entry_names[i]}
        dir=${entry_dirs[i]}
        installed=-
        status="not installed"
        if [[ ! -x ${dir}/update.sh ]]; then
            status="missing update.sh"
        elif installed=$(installed_version "${name}"); then
            local check=0
            "${dir}/update.sh" --check >/dev/null 2>&1 || check=$?
            if (( check == 10 )); then
                status="rebuild needed"
            elif (( check != 0 )); then
                status="check failed"
            elif package=$(newest_package "${dir}" "${name}") &&
                built=$(package_file_version "${package}") &&
                [[ ${built} != "${installed}" ]]; then
                status="ready to install ${built}"
            else
                status="up to date"
            fi
        else
            installed=-
        fi
        printf '%-28s %-14s %-24s %s\n' "${name}" "${installed}" "${status}" "$(tilde "${dir}")"
    done
}

cmd_available() {
    (( $# == 0 )) || { usage >&2; exit 1; }
    load_catalog
    load_entries
    printf '%-28s %-22s %s\n' NAME STATUS URL
    local name status version
    for name in $(printf '%s\n' "${!catalog[@]}" | sort); do
        if version=$(installed_version "${name}"); then
            status="installed ${version}"
        elif find_entry "${name}"; then
            status="managed, not installed"
        else
            status="available"
        fi
        printf '%-28s %-22s %s\n' "${name}" "${status}" "${catalog[${name}]}"
    done
}

added_name=
show_install_hint=1

# Registers SOURCE; sets added_name. A checkout that was just cloned for it is
# removed again if it turns out not to be a usable package.
cmd_add() {
    local args=() arg
    for arg in "$@"; do
        case ${arg} in
            --yes) assume_yes=1 ;;
            -*) die "unknown option: ${arg}" ;;
            *) args+=("${arg}") ;;
        esac
    done
    (( ${#args[@]} >= 1 && ${#args[@]} <= 2 )) || { usage >&2; exit 1; }
    load_entries
    if find_entry "${args[0]}"; then
        die "${args[0]} is already managed (${entry_dirs[entry_index]})."
    fi
    resolve_source "${args[0]}" ||
        die "${args[0]} isn't a directory, a catalog package (see: ns-custom-packages available) or a git URL."
    local dir=${resolved_dir} name cloned=${resolved_cloned}
    reject() {
        if (( cloned )); then
            rm -rf -- "${dir}"
        fi
        die "$@"
    }
    [[ -d ${dir} ]] || reject "${dir} isn't a directory."
    [[ -f ${dir}/PKGBUILD ]] || reject "${dir} has no PKGBUILD."
    [[ -x ${dir}/update.sh ]] || reject "${dir} needs an executable update.sh (see the header of $0)."
    if (( ${#args[@]} == 2 )); then
        name=${args[1]}
    elif [[ -n ${resolved_name} ]]; then
        name=${resolved_name}
    else
        # the package name the PKGBUILD declares, else the directory's name
        name=$(cd "${dir}" && source ./PKGBUILD >/dev/null 2>&1 && printf %s "${pkgname[0]}") || name=
        name=${name:-$(basename "${dir}")}
    fi
    load_entries
    local i
    for i in "${!entry_names[@]}"; do
        if [[ ${entry_names[i]} == "${name}" ]]; then
            reject "${name} is already managed (${entry_dirs[i]})."
        fi
        if [[ ${entry_dirs[i]} == "${dir}" ]]; then
            reject "${dir} is already managed as ${entry_names[i]}."
        fi
    done
    mkdir -p "$(dirname "${packages_file}")"
    # make sure the new entry starts on its own line
    if [[ -s ${packages_file} && -n $(tail -c1 "${packages_file}") ]]; then
        echo >> "${packages_file}"
    fi
    printf '%s %s\n' "$(tilde "${dir}")" "${name}" >> "${packages_file}"
    added_name=${name}
    echo "Added ${name} ($(tilde "${dir}"))."
    if (( show_install_hint )) && ! installed_version "${name}" >/dev/null; then
        echo "It isn't installed yet. Build and install it with: ns-custom-packages install ${name}"
    fi
}

cmd_install() {
    local args=() arg name
    for arg in "$@"; do
        case ${arg} in
            --yes) assume_yes=1 ;;
            -*) die "unknown option: ${arg}" ;;
            *) args+=("${arg}") ;;
        esac
    done
    (( ${#args[@]} == 1 )) || { usage >&2; exit 1; }
    load_entries
    if find_entry "${args[0]}"; then
        name=${args[0]}
    else
        # not managed yet: a directory, catalog name or git URL is added first
        show_install_hint=0
        cmd_add "${args[0]}"
        name=${added_name}
        load_entries
        find_entry "${name}" || die "${name} could not be added."
    fi
    local dir=${entry_dirs[entry_index]} package
    [[ -x ${dir}/update.sh ]] || die "${dir}/update.sh not found."
    build_if_needed "${dir}" "${name}" || die "${name}: build failed."
    if ! package=$(newest_package "${dir}" "${name}"); then
        # up to date as far as update.sh can tell, but nothing has been built here yet
        "${dir}/update.sh" || die "${name}: build failed."
        package=$(newest_package "${dir}" "${name}") || die "${name}: no package was built in ${dir}."
    fi
    echo "${name}: installing $(package_file_version "${package}")..."
    # no --noconfirm: pacman's questions (conflicts, for instance) are the point
    sudo pacman -U "${package}"
}

# Drops NAME's line from the packages file, keeping everything else as it is.
drop_entry() {
    local tmp line dir name _
    tmp=$(mktemp)
    while IFS= read -r line <&3 || [[ -n ${line} ]]; do
        dir='' name=''
        read -r dir name _ <<< "${line}" || true
        if [[ -n ${dir} && ${dir} != '#'* ]]; then
            dir=${dir/#\~\//${HOME}/}
            if [[ ${name:-$(basename "${dir}")} == "$1" ]]; then
                continue
            fi
        fi
        printf '%s\n' "${line}" >> "${tmp}"
    done 3< "${packages_file}"
    cat "${tmp}" > "${packages_file}"
    rm -f "${tmp}"
}

cmd_remove() {
    local args=() arg keep_source=0
    for arg in "$@"; do
        case ${arg} in
            --keep-source) keep_source=1 ;;
            -*) die "unknown option: ${arg}" ;;
            *) args+=("${arg}") ;;
        esac
    done
    (( ${#args[@]} == 1 )) || { usage >&2; exit 1; }
    load_entries
    find_entry "${args[0]}" || die "${args[0]} isn't a managed package."
    local name=${args[0]} dir=${entry_dirs[entry_index]} version provided=() item
    if version=$(installed_version "${name}"); then
        # what it stands in for, so the way back can be shown afterwards
        for item in $(LC_ALL=C pacman -Qi "${name}" | awk -F' *: *' '/^Provides/ {print $2}'); do
            [[ ${item} == None ]] || provided+=("${item%%=*}")
        done
        echo "${name}: uninstalling ${version}..."
        # no --noconfirm: pacman shows what it is about to remove
        sudo pacman -Rns "${name}" || die "${name} was not uninstalled, so it is still managed."
    fi
    drop_entry "${name}"
    echo "${name} is no longer managed."
    if (( ! keep_source )); then
        delete_checkout "${dir}" "${name}"
    fi
    for item in ${provided[@]+"${provided[@]}"}; do
        if ! pacman -Q "${item}" >/dev/null 2>&1 && pacman -Si "${item}" >/dev/null 2>&1; then
            echo "The repository package ${item} is not installed; to get it back: sudo pacman -S ${item}"
        fi
    done
}

# --------------------------------------------------------------------- main

command=${1:-update}
(( $# )) && shift
case ${command} in
    update) cmd_update "$@" ;;
    list) cmd_list "$@" ;;
    available) cmd_available "$@" ;;
    add) cmd_add "$@" ;;
    install) cmd_install "$@" ;;
    remove) cmd_remove "$@" ;;
    -h | --help | help) usage ;;
    *) usage >&2; exit 1 ;;
esac
